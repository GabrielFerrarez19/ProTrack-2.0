{
  "compilerOptions": {
    // Target e módulo
    "target": "ES2020",
    "module": "CommonJS",

    // Diretórios
    "rootDir": "src",
    "outDir": "dist",

    // Compatibilidade e interoperabilidade
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,

    // Source maps e declarações
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    // Verificações estritas adicionais
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": false,
    "moduleDetection": "force",

    // JSX (para projetos React)
    "jsx": "react-jsx",
    "verbatimModuleSyntax": false,

    // Tipos adicionais
    "types": []
  },
  "include": ["src"],
  "exclude": ["node_modules"]
}
